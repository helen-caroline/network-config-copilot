# Qual LLM usar por padrão: "anthropic" ou "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# OpenAI (opcional — só necessário se LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Dispositivo alvo (o simulador local usa estes valores por padrão)
NETCOPILOT_HOST=127.0.0.1
NETCOPILOT_PORT=2222
NETCOPILOT_USERNAME=admin
NETCOPILOT_PASSWORD=admin

# Onde gravar o audit log (uma linha JSON por requisição)
NETCOPILOT_AUDIT_LOG=audit_log.jsonl
